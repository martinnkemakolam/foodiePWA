- var isUser = state.model.authObject.role === 'user'
- var isLoggedIn = state.model.authObject.email
- var activeStyle = "px-[5px] py-[2px] bg-[#eee] text-[#123411] rounded"
div(class="bg-[#123411] max-w-[2000px] mx-auto")

    div(class="flex justify-between items-center text-[#aaa]  py-[20px]")

        div
            p Logo

        div(class="flex gap-4 items-center")
            if (url === ("#/" || "#"))
                a(href="./#/" class=activeStyle) Product
            else
                a(href="./#/") Product
            if !isUser && isLoggedIn
                if (url === ('#/cms' || '#/cms/'))
                    a(href="./#/cms" class=activeStyle) CMS
                else
                    a(href="./#/cms") CMS
            if (url === ('#/cart' || '#/cart'))
                a(href="./#/cart" class=activeStyle) Cart
            else
                a(href="./#/cart") Cart
            if (url === ('#/orders' || '#/orders/'))
                a(href="./#/orders" class=activeStyle) Orders
            else
                a(href="./#/orders") Orders

        div
            if !isLoggedIn && url !== '#/cms'
                button(data-login) Signin/Signup
            else
                button(data-btn = "logout") Log out
            if url === '#/cms' && isUser
                div
                    a(href="./#/cms/add") Add a product
    
    if privateState.tags.length > 0
        div(class="flex w-full px-[20px] gap-[20px] py-[10px] border rounded overflow-auto")
            each value, index in privateState.tags
                div(class=activeStyle + " w-fit")= value.tag_name



