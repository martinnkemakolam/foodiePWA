- var linkStyle = "underline cursor-pointer"
- var privateStateLoginForm = privateState.loginForm
div
    if privateState.loginForm
        h1(class="font-bold") Login
        span(class=linkStyle data-toggle) Sign up.
    else
        h1(class="font-bold") Signup
        span(class=linkStyle data-toggle) Sign in.
if privateState.loginForm
    p Fill in your email and pssword to login and get our products
else
    p Sign up with your Email and create a password
div
    form
        div
            p Email:
            input(type="email")
        div
            p Password:
            input(type="password", value="") 
            
        if privateState.loginForm
            if privateState.isLoading
                button Loading...
            else 
                button(data-signin) Sign in
        else
            if privateState.isLoading
                button Loading...
            else 
                button(data-signup) Sign up