
div
    if privateState.loginForm
        p Don't have an account?
        span(data-toggle) Sign up.
    else
        p Already have an account?
        span(data-toggle) Sign in.
if privateState.loginForm
    h1 Sign in
else
    h1 Sign up
div
    form
        div
            p Email:
            input(type="email")
        div
            p Password:
            input(type="password", value="") 
            
            div
                input(type="checkbox")
                p I've read and agreed with the terms and conditions
        if privateState.loginForm
            if privateState.isLoading
                button Loading...
            else 
                button(data-signin) Sign in
        else
            if privateState.isLoading
                button Loading...
            else 
                button(data-signup) Sign up