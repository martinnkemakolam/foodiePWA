div.food
    img(src= prop.src).product
    div(class="h-[250px] overflow-hidden")
        h1= prop.name
        p(class="text-ellipsis overflow-hidden")= prop.detail
    div.bottom
        a(href=`.#/product/${prop.uid}`) view product 
        div.cartBtn
            h2= prop.price
            button(data-addtocart class="px-4 py-2")
                //- img( width="30px" height="30px" src="./images/icons/cart.png" data-addtocart)
                p(data-addtocart) Add to cart