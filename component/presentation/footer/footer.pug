if state.model.showFooter
    footer(class="w-full bg-neutral-800 items-center gap-2 flex ")
        img(src="./images/icons/market place.png" class="w-20 h-20" )
        div(class="w-full")
          p(class="w-full mb-0").
            Download our application on your devices for easy access to our store
          button(class="p-2 bg-white text-black rounded" data-install) Install
