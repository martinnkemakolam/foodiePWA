if state.model.notification.show
    div(class="flex p-2 gap-2 w-full bg-gray-800 left-0 top-0 rounded text-white fixed")
            img(src=state.model.notification.src , class="bg-white" alt="", width='90', height='40')
            div(class="w-90")
                h1(class="text-2xl text-grey-100") #{state.model.notification.title}
                p(class="text-2l") #{state.model.notification.msg}