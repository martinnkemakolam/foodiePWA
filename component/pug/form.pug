div.imgAdder
    h1 General
    form
        div
            p Product name
            input(type="text" placeholder="Enter product name" id="name" value= prop.name)
            p Product names is recommended to be unique
        div
            p Product description
            textarea(id="detail")= prop.detail
        div
            p Product price
            input(type="number" placeholder="Enter product price" id="price", value= prop.price)
        button(data-add) Submit
